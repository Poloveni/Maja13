# ---- La Maja 13 / La Casa ----
PORT=3000
# URL publique du site (sans slash final) — sert aussi pour le callback Discord
BASE_URL=https://lamaja13.example.com
# Secret de session : générer avec  openssl rand -hex 32
SESSION_SECRET=change-me

# PostgreSQL
DATABASE_URL=postgres://maja13:motdepasse@127.0.0.1:5432/maja13
# (Docker) mot de passe de la base — docker-compose.yml construit DATABASE_URL tout seul
POSTGRES_PASSWORD=change-me

# Discord OAuth (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# ID du serveur Discord La Maja 13 : seuls ses membres peuvent entrer
DISCORD_GUILD_ID=
# Optionnel : correspondance rôle Discord -> grade, format  roleId:grade,roleId:grade
# grades possibles : jefe, segundo, devweb, palabrero, commandante, sicario, soldado, recluta
DISCORD_ROLE_MAP=
# Optionnel : IDs Discord des admins (Jefe/Segundo), séparés par des virgules
ADMIN_DISCORD_IDS=

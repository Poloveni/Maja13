[Unit]
Description=La Maja 13 — site + La Casa
After=network.target postgresql.service

[Service]
Type=simple
User=maja13
WorkingDirectory=/var/www/maja13/server
EnvironmentFile=/var/www/maja13/server/.env
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
